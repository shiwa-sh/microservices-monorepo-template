{
  "openapi": "3.1.0",
  "info": {
    "title": "API reference",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "products"
    },
    {
      "name": "orders"
    },
    {
      "name": "orgs"
    },
    {
      "name": "charges"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "description": "List all products.",
        "tags": [
          "products"
        ],
        "responses": {
          "200": {
            "description": "The product list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  },
                  "example": [
                    {
                      "id": "6f7a1c48-1a9d-4b1e-9a2c-0f27f7f0c001",
                      "name": "Aeron chair",
                      "price_cents": 129900
                    },
                    {
                      "id": "6f7a1c48-1a9d-4b1e-9a2c-0f27f7f0c002",
                      "name": "Standing desk",
                      "price_cents": 89900
                    },
                    {
                      "id": "6f7a1c48-1a9d-4b1e-9a2c-0f27f7f0c003",
                      "name": "Monitor arm",
                      "price_cents": 14900
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "description": "Fetch a product by id.",
        "tags": [
          "products"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Product id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "checkout",
        "tags": [
          "orders"
        ],
        "description": "Starts the Checkout Temporal saga (ADR-0302).",
        "requestBody": {
          "required": true,
          "description": "The checkout to start.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowHandle"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "description": "Fetch an order by id.",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Order id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orgs": {
      "post": {
        "operationId": "createOrg",
        "description": "Create an organization.",
        "tags": [
          "orgs"
        ],
        "requestBody": {
          "required": true,
          "description": "The organization to create.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrgInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orgs/{id}": {
      "get": {
        "operationId": "getOrg",
        "description": "Fetch an organization by id.",
        "tags": [
          "orgs"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/charges": {
      "post": {
        "operationId": "createCharge",
        "tags": [
          "charges"
        ],
        "description": "Starts the Charge Temporal workflow. Idempotent on Idempotency-Key header.\nReturns a workflow handle (ADR-0302).\n",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-generated key that makes the charge request idempotent.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The charge to create.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChargeInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowHandle"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/charges/{id}": {
      "get": {
        "operationId": "getCharge",
        "description": "Fetch a charge by id.",
        "tags": [
          "charges"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Charge id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "An error, as RFC 9457 problem details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details. Served as `application/problem+json` by services and\nby the edge alike, so a generated client has one error branch rather than two.\n",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "`about:blank`, except where two errors share a status code and a client\nhandles them differently. That case takes a `urn:problem-type:<service>:<slug>`\nURN — never a dereferenceable URL, which would put an error taxonomy into\nthe flat public URL namespace.\n",
            "default": "about:blank",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "A stable, human-readable summary. Does not vary with the instance.",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status, duplicated in the body.",
            "minimum": 100,
            "maximum": 599,
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "Instance-specific and safe to show a user. Never a stack trace, a query, or\nan internal hostname.\n",
            "example": "No product with that identifier."
          },
          "trace_id": {
            "type": "string",
            "description": "The W3C Trace Context trace-id of the failing request, so a user-reported\nerror reaches its trace. Supplied from the active span, not by the handler.\n",
            "pattern": "^[0-9a-f]{32}$",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "errors": {
            "type": "array",
            "description": "Field-level validation failures, populated from the generated validator.\nAbsent when the failure is not a validation failure.\n",
            "items": {
              "type": "object",
              "required": [
                "pointer",
                "message"
              ],
              "properties": {
                "pointer": {
                  "type": "string",
                  "description": "RFC 6901 JSON Pointer to the offending member.",
                  "example": "/price_cents"
                },
                "message": {
                  "type": "string",
                  "example": "must be greater than or equal to 0"
                }
              }
            }
          }
        },
        "example": {
          "type": "about:blank",
          "title": "Not Found",
          "status": 404,
          "detail": "No product with that identifier.",
          "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736"
        }
      },
      "Product": {
        "type": "object",
        "description": "A catalog product.",
        "required": [
          "id",
          "name",
          "price_cents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "example": {
          "id": "6f7a1c48-1a9d-4b1e-9a2c-0f27f7f0c001",
          "name": "Aeron chair",
          "price_cents": 129900
        }
      },
      "WorkflowHandle": {
        "type": "object",
        "description": "Handle to an async Temporal workflow run.",
        "required": [
          "id",
          "run_id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "result_url": {
            "type": "string",
            "format": "uri",
            "description": "GET to fetch terminal status + result"
          }
        },
        "example": {
          "id": "charge-7d1e4a95-3c82-4f17-9b06-0f27f7f0f001",
          "run_id": "019a3f8c-6d21-7c4b-8e55-0f27f7f0e002",
          "status": "running",
          "result_url": "/api/charges/7d1e4a95-3c82-4f17-9b06-0f27f7f0f001"
        }
      },
      "CheckoutInput": {
        "type": "object",
        "description": "Request body to start a checkout.",
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Order": {
        "type": "object",
        "description": "A customer order.",
        "required": [
          "id",
          "product_id",
          "quantity",
          "total_cents",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer"
          },
          "total_cents": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "failed",
              "cancelled"
            ]
          }
        },
        "example": {
          "id": "2c9f0b71-5d64-4a0e-9b83-0f27f7f0d001",
          "product_id": "6f7a1c48-1a9d-4b1e-9a2c-0f27f7f0c001",
          "quantity": 2,
          "total_cents": 259800,
          "status": "confirmed"
        }
      },
      "Org": {
        "type": "object",
        "description": "An organization.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "example": {
          "id": "4a8b2d63-9e15-4c70-8d21-0f27f7f0a001",
          "name": "Northwind Trading"
        }
      },
      "OrgInput": {
        "type": "object",
        "description": "Request body to create an organization.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ChargeInput": {
        "type": "object",
        "description": "Request body to create a charge.",
        "required": [
          "order_id",
          "amount_cents"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Charge": {
        "type": "object",
        "description": "A payment charge against an order.",
        "required": [
          "id",
          "order_id",
          "amount_cents",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_cents": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "settled",
              "failed",
              "refunded"
            ]
          }
        },
        "example": {
          "id": "7d1e4a95-3c82-4f17-9b06-0f27f7f0f001",
          "order_id": "2c9f0b71-5d64-4a0e-9b83-0f27f7f0d001",
          "amount_cents": 259800,
          "status": "settled"
        }
      }
    }
  }
}
