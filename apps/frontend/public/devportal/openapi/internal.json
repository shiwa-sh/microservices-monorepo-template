                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "operationId": "updateProduct",
        "description": "Update a product.",
        "tags": [
          "products"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id of the product to update.",
            "schema": {
              "$ref": "#/components/schemas/ProductId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The new product fields.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "description": "Delete a product.",
        "tags": [
          "products"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id of the product to delete.",
            "schema": {
              "$ref": "#/components/schemas/ProductId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "description": "List all orders.",
        "tags": [
          "orders"
        ],
        "responses": {
          "200": {
            "description": "The order list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  },
                  "example": [
                    {
                      "id": "order_01kztnj6c8e0jt7vzw0cn1wxvd",
                      "product_id": "product_01kztmx9e0fq1r13w5d1aerqw6",
                      "quantity": 2,
                      "total": {
                        "amount": "2598.00",
                        "currency": "EUR"
                      },
                      "status": "confirmed"
                    },
                    {
                      "id": "order_01kztnpc5gfx2a9kkhxe1h4ar3",
                      "product_id": "product_01kztn1f78evjtsk2gbgjk5hs3",
                      "quantity": 1,
                      "total": {
                        "amount": "899.00",
                        "currency": "EUR"
                      },
                      "status": "pending"
                    },
                    {
                      "id": "order_01kztnthyrfsj8a9pjx1md2pqs",
                      "product_id": "product_01kztn5n0gfphac1fsep3b64nj",
                      "quantity": 4,
                      "total": {
                        "amount": "596.00",
                        "currency": "EUR"
                      },
                      "status": "cancelled"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "checkout",
        "tags": [
          "orders"
        ],
        "description": "Starts the Checkout Temporal saga (ADR-0302). Idempotent on the\nIdempotency-Key header: a retry of the same request returns the order the\nfirst one created rather than placing a second.\n",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-generated key that makes the checkout idempotent.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The checkout to start.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowHandle"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
