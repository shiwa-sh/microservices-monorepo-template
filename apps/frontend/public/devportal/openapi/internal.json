  "components": {
    "responses": {
      "Error": {
        "description": "An error, as RFC 9457 problem details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details. Served as `application/problem+json` by services and\nby the edge alike, so a generated client has one error branch rather than two.\n",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "`about:blank`, except where two errors share a status code and a client\nhandles them differently. That case takes a `urn:problem-type:<service>:<slug>`\nURN — never a dereferenceable URL, which would put an error taxonomy into\nthe flat public URL namespace.\n",
            "default": "about:blank",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "A stable, human-readable summary. Does not vary with the instance.",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status, duplicated in the body.",
            "minimum": 100,
            "maximum": 599,
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "Instance-specific and safe to show a user. Never a stack trace, a query, or\nan internal hostname.\n",
            "example": "No product with that identifier."
          },
          "trace_id": {
            "type": "string",
            "description": "The W3C Trace Context trace-id of the failing request, so a user-reported\nerror reaches its trace. Supplied from the active span, not by the handler.\n",
            "pattern": "^[0-9a-f]{32}$",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "errors": {
            "type": "array",
            "description": "Field-level validation failures, populated from the generated validator.\nAbsent when the failure is not a validation failure.\n",
            "items": {
              "type": "object",
              "required": [
                "pointer",
                "message"
              ],
              "properties": {
                "pointer": {
                  "type": "string",
                  "description": "RFC 6901 JSON Pointer to the offending member.",
                  "example": "/price/amount"
                },
                "message": {
                  "type": "string",
                  "example": "must be a decimal amount"
                }
              }
            }
          }
        },
        "example": {
          "type": "about:blank",
          "title": "Not Found",
          "status": 404,
          "detail": "No product with that identifier.",
          "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736"
        }
      },
      "WorkflowHandle": {
        "type": "object",
        "description": "Handle to an async Temporal workflow run.",
        "required": [
          "id",
          "run_id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "result_url": {
            "type": "string",
            "format": "uri-reference",
            "description": "GET to fetch terminal status + result"
          }
        },
        "example": {
          "id": "charge-charge_01kztnyqr0f13shqqnx8028xx5",
          "run_id": "019a3f8c-6d21-7c4b-8e55-0f27f7f0e002",
          "status": "running",
          "result_url": "/api/charges/charge_01kztnyqr0f13shqqnx8028xx5"
        }
      },
      "Money": {
        "type": "object",
        "description": "A monetary amount. The amount is a decimal STRING — a JSON number becomes a\ndouble in the TypeScript client, and a double cannot hold a decimal amount\nexactly. Currency travels with the amount, because an amount without one is\nnot a quantity of anything.\n",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Decimal amount, sign-prefixed when negative. No thousands separators.",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "example": "1299.00"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 alphabetic code, uppercase.",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          }
        },
        "example": {
          "amount": "1299.00",
          "currency": "EUR"
        }
      },
      "ProductId": {
        "type": "string",
        "description": "A product identifier: `product_` and the UUIDv7 in 26 characters of Crockford\nbase32. Opaque to a consumer: nothing parses, orders, or constructs one.\n",
        "pattern": "^product_[0-7][0-9abcdefghjkmnpqrstvwxyz]{25}$",
        "example": "product_01kztmx9e0fq1r13w5d1aerqw6"
      },
      "Product": {
        "type": "object",
        "description": "A catalog product.",
        "required": [
          "id",
          "name",
          "price"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ProductId"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "example": {
          "id": "product_01kztmx9e0fq1r13w5d1aerqw6",
          "name": "Aeron chair",
          "price": {
            "amount": "1299.00",
            "currency": "EUR"
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "description": "Request body to create a product.",
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "OrderId": {
        "type": "string",
        "description": "An order identifier: `order_` and the UUIDv7 in 26 characters of Crockford\nbase32. Opaque to a consumer: nothing parses, orders, or constructs one.\n",
        "pattern": "^order_[0-7][0-9abcdefghjkmnpqrstvwxyz]{25}$",
        "example": "order_01kztnj6c8e0jt7vzw0cn1wxvd"
      },
      "CheckoutInput": {
        "type": "object",
        "description": "Request body to start a checkout.",
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "$ref": "#/components/schemas/ProductId"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Order": {
        "type": "object",
        "description": "A customer order.",
        "required": [
          "id",
          "product_id",
          "quantity",
          "total",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OrderId"
          },
          "product_id": {
            "$ref": "#/components/schemas/ProductId"
          },
          "quantity": {
