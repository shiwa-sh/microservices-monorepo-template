{
  "openapi": "3.1.0",
  "info": {
    "title": "API reference",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "products"
    },
    {
      "name": "orders"
    },
    {
      "name": "orgs"
    },
    {
      "name": "charges"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "description": "List all products.",
        "tags": [
          "products"
        ],
        "responses": {
          "200": {
            "description": "The product list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  },
                  "example": [
                    {
                      "id": "product_01kztmx9e0fq1r13w5d1aerqw6",
                      "name": "Aeron chair",
                      "price": {
                        "amount": "1299.00",
                        "currency": "EUR"
                      }
                    },
                    {
                      "id": "product_01kztn1f78evjtsk2gbgjk5hs3",
                      "name": "Standing desk",
                      "price": {
                        "amount": "899.00",
                        "currency": "EUR"
                      }
                    },
                    {
                      "id": "product_01kztn5n0gfphac1fsep3b64nj",
                      "name": "Monitor arm",
                      "price": {
                        "amount": "149.00",
                        "currency": "EUR"
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createProduct",
        "description": "Create a product.",
        "tags": [
          "products"
        ],
        "requestBody": {
          "required": true,
          "description": "The product to create.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "description": "Fetch a product by id.",
