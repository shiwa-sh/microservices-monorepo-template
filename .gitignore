# Editors
.idea/
*.iml
.run/
.vscode/
.history
*~
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env files (ADR-0202: never commit real secrets; encrypted .enc.yaml is ok)
.env
.env.*
!.env.example

# Go
/bin/
/dist/
*.test
*.out
coverage.*

# Node / Bun
node_modules/
.next/
out/
.bun/
*.tsbuildinfo

# Biome (ADR-0400)
.biome/

# Playwright e2e (ADR-0400, ADR-0601)
playwright-report/
test-results/
# Lighthouse CI output: the HTML/JSON reports and lhci's own state directory. CI
# uploads them as an artifact; locally they are noise.
lighthouse-report/
.lighthouseci/
blob-report/
# Saved auth storage states (session cookies) from the e2e setup project.
test/e2e/.auth/

# k6 load-run summaries (ADR-0601). Evidence attached to a PR or a CI artifact,
# not repo content — a committed one would be stale the next day.
test/perf/results/

# Helm / Terraform
**/charts/*.tgz
# ...except the observability subcharts, which are vendored into git so ArgoCD's
# repo-server renders them offline (no `helm dependency build` / network, which
# wedges behind the local privoxy edge). See observability/Chart.yaml.
!infra/helm/platform/observability/charts/*.tgz
# `helm dependency update` unpacks into `tmpcharts-<pid>/` beside the chart and
# leaves the directory behind when the download fails. Scratch, never content.
**/tmpcharts-*/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
core.*


# Mise local cache
.mise.local.toml

# Rumble cache
.rumdl_cache

# Compiled Go binaries dropped at the repo root. `go build ./tools/<name>` with no
# -o writes the binary into the CWD named after the package, and the root is where
# most people run it from — so a stray 3 MB artefact is one forgotten flag away, and
# nothing else here would have caught it. Every tool is RUN with `go run` (see the
# lint tasks in .mise.toml); a built binary is scratch either way.
/lint-*
/gen-*
/data-classes
/zod-gen

# Local-only working files, never committed (AGENTS.md)
*.local.md
