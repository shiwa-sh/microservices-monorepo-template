# Local inner-loop environment for `orders` (ADR-0003, ADR-0016).
# Copy to .env — `mise run server` / `mise run worker` and your IDE's debugger pick it up.
#
# Prereqs (then port-forward the deps to localhost):
#   mise run dev:forward     # separate terminal, leave running
#   mise run migrate         # once per schema change
#
# There is no cluster step to remember: `mise run server` declares the dependency
# components it needs and mise brings up cluster:base plus exactly those, skipping
# whatever is already Ready (ADR-0016, ADR-0030).

# Port-forwarded local Postgres (see infra/local/deps.yaml).
DATABASE_URL=postgres://dev:dev@localhost:5432/orders?sslmode=disable

# OpenFGA (libs/go/authz) — dialed lazily, but the key is required at startup.
# The lite deps run an in-memory OpenFGA with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Temporal (libs/go/temporalmw) — required by `mise run worker`, which runs the
# checkout saga (ADR-0006).
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# The checkout saga calls catalog and payment over HTTP (ADR-0006). In-cluster they
# resolve by DNS; a natively-run worker cannot, so these point at their registered
# local ports instead (scripts/lib/ports.sh).
#
# You do not have to arrange that yourself: `mise run worker` declares
# svc:catalog and svc:payment, which deploy each callee and forward it to the port
# below. Start one natively instead and the graph sees the port answered and leaves
# it alone — which is how you debug the saga across all three at once.
CATALOG_URL=http://localhost:8081
PAYMENT_URL=http://localhost:8084

# PORT is set from the registry in .mise.toml (8082 for orders). Uncomment to
# override — .env wins — but prefer editing the registry so siblings agree.
# PORT=8082

# Uncomment when running an OTel collector locally (none ships in the lite deps).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
