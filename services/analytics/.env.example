# Local inner-loop environment for `analytics` (ADR-0200, ADR-0205).
# Copy to .env — `mise run server` and your IDE's debugger pick it up.
#
# Prereqs (then port-forward the deps to localhost):
#   mise run dev:forward     # separate terminal, leave running
#   mise run migrate         # once per schema change

# Port-forwarded local Postgres (see infra/local/deps.yaml).
DATABASE_URL=postgres://dev:dev@localhost:5432/analytics?sslmode=disable

# The funnel definitions (ADR-0700). The image bakes them at
# /etc/analytics/funnels.yaml; running natively, the repo copy is the one to read.
FUNNELS_PATH=infra/analytics/funnels.yaml

# No OpenFGA and no Temporal. The panel over this store is authorised in the render
# layer (ADR-0700), and the rollup runs in the platform worker — this service only
# answers the request it makes.

# Uncomment when running an OTel collector locally (none ships in the lite deps).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
