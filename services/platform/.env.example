# Local inner-loop environment for the platform worker (ADR-0302).
#
#   mise run dev:forward     # separate terminal
#   mise run worker

TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Where periodic obligations file their tracking issues. Empty until a forge
# exists: the activity logs what it would have filed rather than failing, so a
# scheduled run is not permanently red for a reason nobody can fix.
FORGE_API_URL=

# Uncomment when running an OTel collector locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
