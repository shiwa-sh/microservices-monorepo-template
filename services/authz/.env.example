# Local inner-loop environment for `authz` (ADR-0200, ADR-0205, ADR-0306).
# Copy to .env — `mise run server` and your IDE's debugger pick it up.
#
# authz is the ops-tier edge authorizer: no database, no worker. It needs OpenFGA,
# and Kratos only for the identity-listing endpoints.
#
# Prereqs:
#   mise run dev:forward     # separate terminal, leave running
#
# There is no cluster step to remember: `mise run server` declares the dependency
# components it needs and mise brings up cluster:base plus exactly those, skipping
# whatever is already Ready (ADR-0205, ADR-0600).

# OpenFGA (libs/go/authz) — dialed lazily, but the key is required at startup.
# The dep:openfga stand-in runs in-memory with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Kratos identity admin API, behind the /identities endpoints the admin console's
# Users page calls. Kratos is NOT in the lite deps — only the full tier runs it
# (`mise run cluster:full`), so port-forward it there before uncommenting:
#   kubectl -n platform port-forward svc/ory-kratos-admin 4434:80
# KRATOS_ADMIN_URL=http://localhost:4434

# Optional fine per-tool OpenFGA layer on top of the always-on coarse claim gate
# (ADR-0306). Default off keeps the coarse gate free of any OpenFGA dependency.
# OPS_FINE_GRAINED=true

# Uncomment when running an OTel collector locally (none ships in the lite deps).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
