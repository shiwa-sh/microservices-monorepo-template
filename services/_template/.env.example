# Local inner-loop environment for `<service>` (ADR-0200, ADR-0205).
# Copy to .env — `mise run server` / `mise run worker` and your IDE's debugger pick it up.
# Rename the database below to match your service, and drop any block you do not use.
#
# Prereqs (then port-forward the deps to localhost):
#   mise run dev:forward     # separate terminal, leave running
#   mise run migrate         # once per schema change
#
# There is no cluster step to remember: `mise run server` declares the dependency
# components it needs and mise brings up cluster:base plus exactly those, skipping
# whatever is already Ready (ADR-0205, ADR-0600).

# Port-forwarded local Postgres. Add a CREATE DATABASE for your service to
# infra/local/deps.yaml and a migrate loop entry to scripts/db-migrate.sh.
DATABASE_URL=postgres://dev:dev@localhost:5432/<service>?sslmode=disable

# OpenFGA (libs/go/authz) — dialed lazily, but the key is required at startup.
# The lite deps run an in-memory OpenFGA with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Temporal (libs/go/temporalmw) — required by `mise run worker`. Delete if your
# service has no cmd/worker.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Uncomment when running an OTel collector locally (none ships in the lite deps).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
