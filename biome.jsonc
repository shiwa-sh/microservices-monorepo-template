{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/libs/ts/sdks",
      "!**/apps/admin/_generated",
      // Generated by scripts/gen-openapi-public.sh (the merged devportal spec
      // projections) — drift-checked by ci:gen, not hand-edited.
      "!**/apps/frontend/public/devportal",
      // The test/e2e/ Playwright workspace is the sanctioned Node island (ADR-0601) with
      // its own toolchain; the frontend-tuned React preset does not apply to it
      // (it is type-checked by its own tsconfig + the Playwright compile).
      "!**/test/e2e"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      // Every Biome rule (incl. nursery), minus the ones that fight Next.js or the ADRs.
      "preset": "all",
      "correctness": {
        // Resolver can't see Next 16 type-only re-exports from next/server.
        "noUnresolvedImports": "off",
        // React Aria collections (Untitled Table) require stable `id` keys on
        // columns/rows; these are collection keys, not DOM ids (ADR-0400).
        "useUniqueElementIds": "off",
        // Qwik-only rule; this is a React app (ADR-0400).
        "useQwikValidLexicalScope": "off",
        // Bundler resolves path aliases and extensionless specifiers.
        "useImportExtensions": "off",
        "noProcessGlobal": "off"
      },
      "performance": {
        // Solid.js-only rule; this is a React app (ADR-0400).
        "useSolidForComponent": "off",
        // The vendored Untitled UI kit ships index barrels (ADR-0400).
        "noBarrelFile": "off"
      },
      "suspicious": {
        // Solid.js-only rule; this is a React app (ADR-0400).
        "noReactSpecificProps": "off"
      },
      "style": {
        // ADR-0400 defers i18n.
        "noJsxLiterals": "off",
        "noProcessEnv": "off",
        // ADR-0303 snake_case fields + Next.js SCREAMING_SNAKE env keys.
        "useNamingConvention": "off",
        // Color literals live in the Untitled token files (src/styles/theme.css).
        "noHexColors": "off",
        "useGlobalThis": "off",
        // Next.js declares `metadata` atop route files.
        "useExportsLast": "off",
        "noMagicNumbers": "off",
        "noImplicitBoolean": "off",
        "noTernary": "off",
        // `type` for object shapes; the one Window-augmentation interface carries a biome-ignore.
        "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
        // Next.js route files co-export metadata/viewport.
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowExportNames": ["metadata", "generateMetadata", "viewport", "generateViewport"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // libs/ts/id is a bit-level codec: it packs a 128-bit value into 26 base32
      // characters five bits at a time (ADR-0003). Bitwise operators and an index
      // counter ARE the domain here, and the rules banning them exist to keep them
      // out of React code, which this is not. The published alphabet and the TypeID
      // conformance vectors also read as high-entropy strings to the secret scanner.
      "includes": ["**/libs/ts/id/**"],
      "linter": {
        "rules": {
          "suspicious": { "noBitwiseOperators": "off" },
          "style": { "noIncrementDecrement": "off" },
          "security": { "noSecrets": "off" }
        }
      }
    },
    {
      // App Router route segments and config files use default exports.
      "includes": ["**/app/**", "**/*.config.{js,cjs,mjs,ts}"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // Writes to stdout via console before slog/OTLP wiring.
      "includes": ["**/apps/frontend/src/lib/observability/server.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Vendored Untitled UI source (ADR-0400): committed third-party primitives,
      // token CSS, and utils kept verbatim from upstream for clean re-sync diffs.
      // Not held to the first-party lint/format rules; tsc still type-checks them.
      "includes": [
        "**/apps/frontend/src/components/base/**",
        "**/apps/frontend/src/components/application/**",
        "**/apps/frontend/src/components/foundations/**",
        "**/apps/frontend/src/utils/cx.ts",
        "**/apps/frontend/src/utils/is-react-component.ts",
        "**/apps/frontend/src/styles/theme.css",
        "**/apps/frontend/src/styles/typography.css",
        "**/apps/frontend/src/styles/globals.css"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // k6 load scenarios (ADR-0601). Formatted like the rest of the repo, but four
      // rules are structurally impossible for a k6 script to satisfy — they are
      // disabled here rather than excluding test/perf/ wholesale (as test/e2e/ is), so every
      // OTHER rule still catches real bugs in scenario code.
      "includes": ["**/test/perf/**"],
      "linter": {
        "rules": {
          "correctness": {
            // `k6/http`, `k6/metrics`, … are engine builtins resolved by k6 itself.
            // There is no package.json to declare them in, and there must not be.
            "noUndeclaredDependencies": "off",
            // `__ENV` is k6's environment global.
            "noUndeclaredVariables": "off"
          },
          // A scenario's entrypoint is `export default function` — k6's contract,
          // not a style choice.
          "style": { "noDefaultExport": "off" },
          // console is the only output channel inside the k6 VM; there is no slog
          // and no OTLP logger to reach for (ADR-0500's rule addresses services).
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Canonical Oathkeeper access rules (ADR-0304): hand-curated one-rule-per-line
      // for readability and consumed verbatim as a Helm --set-file string. Biome's
      // JSON formatter collapses it to one line — never format this artefact.
      "includes": ["**/infra/auth/oathkeeper/access-rules.json"],
      "formatter": { "enabled": false }
    }
  ]
}
